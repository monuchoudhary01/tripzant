{
    "openapi": "3.0.0",
    "info": {
        "title": "Tripzant API Documentation",
        "description": "API endpoints for Tripzant Mobile App",
        "contact": {
            "email": "support@tripzant.com"
        },
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://127.0.0.1:8000/api/v1",
            "description": "Local Development Server"
        },
        {
            "url": "https://tripnstays.com/api/v1",
            "description": "Staging/Live Server"
        }
    ],
    "paths": {
        "/login": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "User Login",
                "description": "Login with email and password to receive a Bearer Token",
                "operationId": "67d6d0fdd54fba132e1b6f55ca254183",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "john@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "password123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Successful login",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "token": {
                                            "type": "string",
                                            "example": "1|abc..."
                                        },
                                        "user": {
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Invalid credentials"
                    }
                }
            }
        },
        "/register": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "User Registration",
                "description": "Register a new user and receive an OTP",
                "operationId": "5d4fa5d5607ed675ba93907e1fc94534",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "email",
                                    "phone",
                                    "password"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "John Doe"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "john@example.com"
                                    },
                                    "phone": {
                                        "type": "string",
                                        "example": "9876543210"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "password123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "OTP sent successfully"
                    }
                }
            }
        },
        "/login/otp/send": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Send Login OTP",
                "description": "Send a 4-digit OTP to the user's mobile for login",
                "operationId": "51f859525ddb7d67c67968bb29e3a10d",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "phone"
                                ],
                                "properties": {
                                    "phone": {
                                        "type": "string",
                                        "example": "9876543210"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "OTP sent successfully"
                    }
                }
            }
        },
        "/login/otp/verify": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Verify Login OTP",
                "description": "Verify mobile OTP to receive a Bearer Token",
                "operationId": "9d1cbcbdcbc874f006d9be4ed2fc7704",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "phone",
                                    "otp"
                                ],
                                "properties": {
                                    "phone": {
                                        "type": "string",
                                        "example": "9876543210"
                                    },
                                    "otp": {
                                        "type": "string",
                                        "example": "1234"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Login successful"
                    }
                }
            }
        },
        "/password/forgot": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Forgot Password",
                "description": "Request an OTP for password reset",
                "operationId": "2a1b15935bc6aaec88107cef54a680f4",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "user@example.com"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "OTP sent successfully"
                    }
                }
            }
        },
        "/password/reset": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Reset Password",
                "description": "Reset password using OTP",
                "operationId": "583c81b550c52da53f5f9c9de3c21c56",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "otp",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email"
                                    },
                                    "otp": {
                                        "type": "string"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Password reset successful"
                    }
                }
            }
        },
        "/flights/search": {
            "get": {
                "tags": [
                    "Flights"
                ],
                "summary": "Search Flights",
                "description": "Search for One-Way, Round-Trip, or Multi-City flights",
                "operationId": "85e361ddb085b867138a5ea2a4061db7",
                "parameters": [
                    {
                        "name": "origin",
                        "in": "query",
                        "description": "Origin airport code (e.g. DEL)",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "example": "DEL"
                        }
                    },
                    {
                        "name": "destination",
                        "in": "query",
                        "description": "Destination airport code (e.g. BOM)",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "example": "BOM"
                        }
                    },
                    {
                        "name": "departure_date",
                        "in": "query",
                        "description": "Departure date (YYYY-MM-DD)",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "format": "date",
                            "example": "2024-12-10"
                        }
                    },
                    {
                        "name": "return_date",
                        "in": "query",
                        "description": "Return date for Round-Trip",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "format": "date",
                            "example": "2024-12-15"
                        }
                    },
                    {
                        "name": "trip",
                        "in": "query",
                        "description": "Trip type",
                        "schema": {
                            "type": "string",
                            "default": "oneway",
                            "enum": [
                                "oneway",
                                "round"
                            ]
                        }
                    },
                    {
                        "name": "multi_city",
                        "in": "query",
                        "description": "Set true for Multi-City",
                        "schema": {
                            "type": "boolean",
                            "default": false
                        }
                    },
                    {
                        "name": "baggage",
                        "in": "query",
                        "description": "Minimum baggage weight (KG)",
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "List of flights"
                    }
                }
            }
        },
        "/flights/details/{id}": {
            "get": {
                "tags": [
                    "Flights"
                ],
                "summary": "Flight Details",
                "description": "Get detailed info for a specific flight from the last search",
                "operationId": "f78919ea4b5d0a83383f07bd8f1fb2f4",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Flight details object"
                    }
                }
            }
        },
        "/flights/book": {
            "post": {
                "tags": [
                    "Flights"
                ],
                "summary": "Book a Flight",
                "description": "Create a flight booking for the authenticated user",
                "operationId": "9608ee10c67f93487109270f4b799fea",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "flight_id",
                                    "passengers"
                                ],
                                "properties": {
                                    "flight_id": {
                                        "type": "string",
                                        "example": "12345"
                                    },
                                    "passengers": {
                                        "type": "array",
                                        "items": {
                                            "type": "object"
                                        }
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Booking successful"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/flights/bookings": {
            "get": {
                "tags": [
                    "Flights"
                ],
                "summary": "My Flight Bookings",
                "description": "Get list of flight bookings for the authenticated user",
                "operationId": "018c4d9b581839d144fb35cc3d676995",
                "responses": {
                    "200": {
                        "description": "List of bookings"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/hotel/book": {
            "post": {
                "tags": [
                    "Hotels"
                ],
                "summary": "Book a Hotel",
                "description": "Create a hotel booking for the authenticated user",
                "operationId": "4a1508448339809778bf674ec32d529a",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "hotel_code",
                                    "room_type",
                                    "check_in",
                                    "check_out",
                                    "guests",
                                    "rate_key",
                                    "holder_name",
                                    "holder_surname",
                                    "email"
                                ],
                                "properties": {
                                    "hotel_code": {
                                        "type": "string"
                                    },
                                    "room_type": {
                                        "type": "string"
                                    },
                                    "check_in": {
                                        "type": "string",
                                        "format": "date"
                                    },
                                    "check_out": {
                                        "type": "string",
                                        "format": "date"
                                    },
                                    "guests": {
                                        "type": "array",
                                        "items": {
                                            "type": "object"
                                        }
                                    },
                                    "rate_key": {
                                        "type": "string"
                                    },
                                    "holder_name": {
                                        "type": "string"
                                    },
                                    "holder_surname": {
                                        "type": "string"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Booking successful"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/hotels/search": {
            "get": {
                "tags": [
                    "Hotels"
                ],
                "summary": "Search Hotels",
                "description": "Search for hotels based on city code and dates",
                "operationId": "b94dcf740b8a9a82b7a9d96b9886ec05",
                "parameters": [
                    {
                        "name": "city_code",
                        "in": "query",
                        "description": "Destination city code (e.g. DXB)",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "example": "DXB"
                        }
                    },
                    {
                        "name": "checkin",
                        "in": "query",
                        "description": "Check-in date (YYYY-MM-DD)",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "format": "date",
                            "example": "2024-12-01"
                        }
                    },
                    {
                        "name": "checkout",
                        "in": "query",
                        "description": "Check-out date (YYYY-MM-DD)",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "format": "date",
                            "example": "2024-12-05"
                        }
                    },
                    {
                        "name": "adults",
                        "in": "query",
                        "description": "Number of adults",
                        "schema": {
                            "type": "integer",
                            "example": 2
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "List of hotels"
                    }
                }
            }
        },
        "/hotels/details/{code}": {
            "get": {
                "tags": [
                    "Hotels"
                ],
                "summary": "Hotel Details",
                "description": "Get room types and availability for a specific hotel",
                "operationId": "cfce546d9a0ff642369cd4fe8847c550",
                "parameters": [
                    {
                        "name": "code",
                        "in": "path",
                        "description": "Hotel code",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "checkIn",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "format": "date"
                        }
                    },
                    {
                        "name": "checkOut",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "format": "date"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Hotel content and availability"
                    }
                }
            }
        },
        "/hotels/bookings": {
            "get": {
                "tags": [
                    "Hotels"
                ],
                "summary": "My Hotel Bookings",
                "description": "Get list of hotel bookings for the authenticated user",
                "operationId": "64b7e9ea2d3c7722a5abdc832680932b",
                "responses": {
                    "200": {
                        "description": "List of hotel bookings"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/get-exchange-rate": {
            "get": {
                "tags": [
                    "Money Transfer"
                ],
                "summary": "Get Exchange Rate",
                "operationId": "629ac3a2b2c228120bd0883c1f968df0",
                "parameters": [
                    {
                        "name": "from",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "USD"
                        }
                    },
                    {
                        "name": "to",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "INR"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Exchange rate result"
                    }
                }
            }
        },
        "/get-providers": {
            "get": {
                "tags": [
                    "Money Transfer"
                ],
                "summary": "Get Transfer Providers",
                "operationId": "a2cfe42c51ef981cd90b25b4a0e54ba8",
                "parameters": [
                    {
                        "name": "from_country",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "US"
                        }
                    },
                    {
                        "name": "from_currency",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "USD"
                        }
                    },
                    {
                        "name": "to_country",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "IN"
                        }
                    },
                    {
                        "name": "to_currency",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "INR"
                        }
                    },
                    {
                        "name": "amount",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "number",
                            "example": 100
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "List of providers"
                    }
                }
            }
        },
        "/create-transfer": {
            "post": {
                "tags": [
                    "Money Transfer"
                ],
                "summary": "Create a Money Transfer",
                "operationId": "072ec1b04a3e851c68fdd19e55b053f7",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "user_id",
                                    "type",
                                    "source_currency",
                                    "source_amount",
                                    "target_currency",
                                    "target_amount",
                                    "exchange_rate",
                                    "recipient_details"
                                ],
                                "properties": {
                                    "user_id": {
                                        "type": "integer"
                                    },
                                    "type": {
                                        "type": "string",
                                        "enum": [
                                            "wallet_to_wallet",
                                            "wallet_to_bank",
                                            "international"
                                        ]
                                    },
                                    "source_currency": {
                                        "type": "string"
                                    },
                                    "source_amount": {
                                        "type": "number"
                                    },
                                    "target_currency": {
                                        "type": "string"
                                    },
                                    "target_amount": {
                                        "type": "number"
                                    },
                                    "exchange_rate": {
                                        "type": "number"
                                    },
                                    "recipient_details": {
                                        "type": "object"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Transfer created successfully"
                    }
                }
            }
        },
        "/webhook/payment-status": {
            "post": {
                "tags": [
                    "Money Transfer"
                ],
                "summary": "Payment Webhook",
                "description": "Webhook endpoint for payment status updates",
                "operationId": "30980eb00713d79cc6b746352da1edb3",
                "responses": {
                    "200": {
                        "description": "Received"
                    }
                }
            }
        },
        "/payment/initiate": {
            "post": {
                "tags": [
                    "Payment"
                ],
                "summary": "Initialize Payment (Mobile App)",
                "description": "Create a payment session for Stripe or MPGS (Commercial Bank)",
                "operationId": "c03375ef12159bfa368107598caa599e",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "type",
                                    "total_amount",
                                    "gateway",
                                    "travelers"
                                ],
                                "properties": {
                                    "type": {
                                        "type": "string",
                                        "example": "flight"
                                    },
                                    "total_amount": {
                                        "type": "number",
                                        "example": 5000
                                    },
                                    "gateway": {
                                        "type": "string",
                                        "enum": [
                                            "stripe",
                                            "mpgs"
                                        ]
                                    },
                                    "travelers": {
                                        "type": "array",
                                        "items": {
                                            "type": "object"
                                        }
                                    },
                                    "item_data": {
                                        "type": "object"
                                    },
                                    "reference": {
                                        "type": "string"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Payment session created"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/payment/success": {
            "post": {
                "tags": [
                    "Payment"
                ],
                "summary": "Confirm Payment (Mobile App)",
                "description": "Verify payment status and confirm the booking record",
                "operationId": "a54e7ddeaa3726396dfc918148e6f4ba",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "reference"
                                ],
                                "properties": {
                                    "reference": {
                                        "type": "string",
                                        "example": "API-ABC123"
                                    },
                                    "transaction_id": {
                                        "type": "string"
                                    },
                                    "gateway": {
                                        "type": "string",
                                        "enum": [
                                            "stripe",
                                            "mpgs"
                                        ]
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Booking confirmed"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        }
    },
